{
  "info": {
    "name": "GarageOS - Fluxo Completo",
    "_postman_id": "garageos-flow-v1",
    "description": "Collection completa do GarageOS cobrindo todo o fluxo: autenticação → cadastros → OS → orçamento → aprovação → entrega.\n\nVariáveis capturadas automaticamente via scripts nos testes:\n- token, clienteId, veiculoId, servicoId, estoqueId, osId, numeroOS\n\nBaseUrl padrão: http://localhost:5218\nAltere a variável de ambiente 'baseUrl' se necessário.\n\nFase 4: orçamento e pagamento estão no Billing Service; estoque, reservas e execução no Execução Service. Esta coleção cobre o OS Service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5218"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "veiculoId",
      "value": ""
    },
    {
      "key": "servicoId",
      "value": ""
    },
    {
      "key": "estoqueId",
      "value": ""
    },
    {
      "key": "osId",
      "value": ""
    },
    {
      "key": "numeroOS",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Autenticação",
      "item": [
        {
          "name": "POST Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.token);",
                  "pm.test('Login OK - token salvo', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin@123\"\n}"
            },
            "description": "Autentica e salva o JWT em {{token}}. Token expira em 60 min."
          }
        }
      ]
    },
    {
      "name": "02 - Cadastros Base",
      "item": [
        {
          "name": "POST Cadastrar Cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('clienteId', json.id);",
                  "pm.test('Cliente criado - ID salvo', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/clientes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João da Silva\",\n  \"documento\": \"00000000191\",\n  \"email\": \"joao.silva@email.com\",\n  \"telefone\": \"11999999999\",\n  \"endereco\": {\n    \"rua\": \"Rua das Flores\",\n    \"numero\": \"123\",\n    \"bairro\": \"Centro\",\n    \"cidade\": \"São Paulo\",\n    \"estado\": \"SP\",\n    \"cep\": \"01001000\"\n  }\n}"
            },
            "description": "Cadastra um cliente. O ID é salvo em {{clienteId}}."
          }
        },
        {
          "name": "GET Listar Clientes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/clientes",
            "description": "Verifica os clientes cadastrados no banco."
          }
        },
        {
          "name": "POST Cadastrar Veículo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('veiculoId', json.id);",
                  "pm.test('Veículo criado - ID salvo', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/veiculos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"ABC1234\",\n  \"marca\": \"Volkswagen\",\n  \"modelo\": \"Gol\",\n  \"ano\": \"2020\"\n}"
            },
            "description": "Cadastra um veículo. O ID é salvo em {{veiculoId}}."
          }
        },
        {
          "name": "PATCH Vincular Veículo ao Cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Veículo vinculado ao cliente', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/veiculos/{{veiculoId}}/vincular-cliente",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{clienteId}}\"\n}"
            },
            "description": "Associa o veículo ao cliente cadastrado."
          }
        },
        {
          "name": "GET Veículo (verificar vínculo)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/veiculos/{{veiculoId}}",
            "description": "Verifica se o veículo está vinculado ao cliente no banco."
          }
        },
        {
          "name": "POST Cadastrar Serviço",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('servicoId', json.id);",
                  "pm.test('Serviço criado - ID salvo', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/servicos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeServico\": \"Troca de Óleo\",\n  \"preco\": 120.00\n}"
            },
            "description": "Cadastra um serviço (mão de obra). O ID é salvo em {{servicoId}}."
          }
        }
      ]
    },
    {
      "name": "03 - Ordem de Serviço",
      "item": [
        {
          "name": "POST Abrir OS completa",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('osId', json.id);",
                  "pm.collectionVariables.set('numeroOS', json.numeroOS);",
                  "pm.test('OS aberta em Recebida, com preço copiado', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(json.status).to.eql('Recebida');",
                  "  pm.expect(json.numeroOS).to.match(/^OS-\\d{4}-\\d{5}$/);",
                  "  pm.expect(json.servicos[0].precoUnitario).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/ordensdeservico/abertura-completa",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"veiculoId\": \"{{veiculoId}}\",\n  \"servicosIds\": [\n    \"{{servicoId}}\"\n  ],\n  \"pecas\": []\n}"
            },
            "description": "Abre a OS com cliente, veículo e serviços (Fase 4: substitui o antigo POST /api/ordensdeservico, que não existe mais). Nome e preço dos serviços são copiados para a OS. Status inicial: Recebida."
          }
        },
        {
          "name": "GET OS (status = Recebida)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('OS em Recebida', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(json.status).to.eql('Recebida');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/ordensdeservico/{{osId}}"
          }
        },
        {
          "name": "POST Adicionar Peça na OS",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Peça incluída e OS em diagnóstico', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(json.pecas.length).to.be.above(0);",
                  "  pm.expect(json.status).to.eql('EmDiagnostico');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/ordensdeservico/{{osId}}/pecas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estoqueId\": \"{{estoqueId}}\",\n  \"quantidade\": 2\n}"
            },
            "description": "A peça é conferida no estoque do Execução Service (GET /api/estoques/{id} de lá) e entra com o valor do momento. Preencha {{estoqueId}} com uma peça cadastrada no Execução. Substitui o antigo /estoques."
          }
        },
        {
          "name": "GET Histórico da OS",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Histórico começa em Recebida', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(json[0].statusNovo).to.eql('Recebida');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/ordensdeservico/{{osId}}/historico",
            "description": "Cada transição de status, com origem e X-Correlation-Id."
          }
        }
      ]
    },
    {
      "name": "04 - Ciclo de Status (manual até a saga, etapa 5)",
      "item": [
        {
          "name": "PATCH Status -> AguardandoAprovacao",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('OS em AguardandoAprovacao', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(json.status).to.eql('AguardandoAprovacao');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/ordensdeservico/{{osId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"AguardandoAprovacao\"\n}"
            },
            "description": "Orçamento pedido ao Billing Service."
          }
        },
        {
          "name": "PATCH Status -> AguardandoPagamento",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('OS em AguardandoPagamento', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(json.status).to.eql('AguardandoPagamento');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/ordensdeservico/{{osId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"AguardandoPagamento\"\n}"
            },
            "description": "Cliente aprovou e as peças foram reservadas no Execução."
          }
        },
        {
          "name": "PATCH Status -> EmExecucao",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('OS em EmExecucao', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(json.status).to.eql('EmExecucao');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/ordensdeservico/{{osId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"EmExecucao\"\n}"
            },
            "description": "Pagamento confirmado."
          }
        },
        {
          "name": "PATCH Status -> Finalizada",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('OS em Finalizada', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(json.status).to.eql('Finalizada');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/ordensdeservico/{{osId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Finalizada\"\n}"
            },
            "description": "Execução concluída no Execução Service."
          }
        },
        {
          "name": "PATCH Status -> Entregue",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('OS em Entregue', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(json.status).to.eql('Entregue');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/ordensdeservico/{{osId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Entregue\"\n}"
            },
            "description": "Veículo entregue ao cliente."
          }
        },
        {
          "name": "PATCH Status inválido (Entregue -> Recebida) = 400/409",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Transição recusada', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([400, 409]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/ordensdeservico/{{osId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Recebida\"\n}"
            },
            "description": "A máquina de estados recusa transições fora da tabela."
          }
        }
      ]
    },
    {
      "name": "05 - Acompanhamento",
      "item": [
        {
          "name": "GET Acompanhar OS (público - sem token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Acompanhamento público retorna 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/ordensdeservico/acompanhar/{{numeroOS}}",
            "description": "Endpoint PÚBLICO (sem autenticação). Cliente consulta status pelo número da OS."
          }
        },
        {
          "name": "GET Listar Todas as OS",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/ordensdeservico",
            "description": "Lista todas as OS para visão geral do banco."
          }
        }
      ]
    }
  ]
}