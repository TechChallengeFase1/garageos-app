# Banco principal
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# PgAdmin
PGADMIN_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# JWT
JWT_SECRET_KEY=
JWT_ISSUER=
JWT_AUDIENCE=

# Admin
ADMIN_USERNAME=
ADMIN_PASSWORD=

# SonarQube DB
SONAR_DB_USER=
SONAR_DB_PASSWORD=

# SonarQube CLI (para análise de código)
# Obtenha o token em: http://localhost:9000/account/security
SONAR_TOKEN=
SONAR_HOST_URL=http://localhost:9000
SONAR_PROJECT_KEY=GarageOS
# New Relic (observabilidade)
# A LICENSE KEY tem 40 caracteres e termina em NRAL. Pegue em:
#   one.newrelic.com > Administration > API keys > linha "INGEST - LICENSE"
#   > menu "..." > Copy key VALUE  (nao "Copy key ID", que e outro dado)
# E segredo: quem tiver consegue injetar dados e consumir sua cota de ingestao.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=
